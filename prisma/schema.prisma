// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StorybookProject {
  id          String   @id @default(cuid())
  title       String
  topic       String
  script      String?
  style       String   @default("paper-cutout")
  resolution  String   @default("1080p")
  voice       String   @default("tongtong")
  music       Boolean  @default(true)
  sceneCount  Int      @default(5)
  scenesJson  String   // JSON-serialized Scene[]
  status      String   @default("draft") // draft | planned | rendering | done
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Trading bot models ──

model Candle {
  id        String   @id @default(cuid())
  pair      String
  timeframe String   // 1m | 5m | 15m | 1h | 1d
  time      Int      // unix seconds, bucket start
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())
  @@unique([pair, timeframe, time])
  @@index([pair, timeframe, time])
}

model Position {
  id         String    @id @default(cuid())
  pair       String
  side       String    @default("long")
  entryPrice Float
  amount     Float
  amountIdr  Float
  stopLoss   Float
  takeProfit Float
  strategy   String
  signalScore Int      @default(0)
  status     String    @default("open") // open | closed
  exitPrice  Float?
  exitTime   DateTime?
  pnl        Float?
  pnlPct     Float?
  orderId    String?
  mode       String    @default("paper") // paper | live
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  @@index([pair, status])
  @@index([openedAt])
}

model BotConfig {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false)
  mode        String   @default("paper") // paper | live
  pair        String   @default("btc_idr")
  strategy    String   @default("sma_cross")
  capitalIdr  Float    @default(1000000)
  riskPct     Float    @default(2)
  stopLossPct Float    @default(3)
  takeProfitPct Float  @default(5)
  intervalSec Int      @default(300)
  apiKey      String?
  secretKey   String?
  telegramToken String?
  telegramChatId String?
  updatedAt   DateTime @updatedAt
}

model BotLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  level     String   // info | warn | error | trade
  message   String
  pair      String?
  meta      String?
}

// P1 (this round): Historical L2 order book snapshots
// Periodically fetched from INDODAX depth API and stored for historical backtest calibration.
// Each snapshot captures the order book structure at a specific point in time.
model L2Snapshot {
  id                 String   @id @default(cuid())
  pair               String   // btc_idr, eth_idr, etc.
  timestamp          Int      // unix seconds when snapshot was taken
  topBidPrice        Float
  topAskPrice        Float
  realSpreadPct      Float    // (ask - bid) / mid * 100
  topBidVolume       Float
  topAskVolume       Float
  topOfBookImbalance Float    // (bidVol - askVol) / (bidVol + askVol) at top of book
  totalBidVolume     Float
  totalAskVolume     Float
  totalImbalance     Float    // depth-weighted imbalance across all levels
  bidLevelsCount     Int
  askLevelsCount     Int
  bidDepthJson       String   // JSON: [{priceLevelPct, cumulativeVol}, ...]
  askDepthJson       String   // JSON: [{priceLevelPct, cumulativeVol}, ...]
  createdAt          DateTime @default(now())
  @@unique([pair, timestamp])
  @@index([pair, timestamp])
}

// L2 collector health state — persisted so the in-process monitor survives
// hot-reloads / restarts. One row per tracked pair + a sentinel "__scheduler__"
// row for global scheduler-liveness state. The in-memory monitor remains the
// fast-path; this table is hydrated on startup and flushed after each cycle.
model L2CollectorHealth {
  id                  String   @id @default(cuid())
  key                 String   @unique // pair name, or "__scheduler__" for global
  lastSuccessAt       Int?
  lastFailureAt       Int?
  lastError           String?
  lastErrorAt         Int?
  consecutiveFailures Int      @default(0)
  totalAttempts       Int      @default(0)
  totalSuccesses      Int      @default(0)
  totalFailures       Int      @default(0)
  lastSnapshotCount   Int      @default(0)
  lastAgeSec          Int?
  lastRetriesUsed     Int      @default(0)
  // Scheduler-liveness fields (only populated on the __scheduler__ row)
  schedulerRunning    Boolean  @default(false)
  lastSchedulerTickAt Int?
  // Circuit-breaker state (only on __scheduler__ row)
  circuitOpen         Boolean  @default(false)
  circuitOpenedAt     Int?
  circuitTrips        Int      @default(0)
  circuitOpenUntil    Int?
  updatedAt           DateTime @updatedAt
}

// ── PSYOP//TERMINAL models ──
// Behavioral confrontation system. The market is the stage; the trader's
// psychology is the subject. These models track the user's behavioral
// patterns, not the market's.

// Every trade intention the user logged (before execution). The system
// requires a "plan" + "confession" before allowing execution. Deviations
// from plan are tracked as tilt indicators.
model PsyopTradeIntention {
  id              String   @id @default(cuid())
  pair            String
  side            String   // long | short | flat
  plannedEntry    Float
  plannedStop     Float
  plannedTarget   Float
  plannedHoldMin  Int      // planned hold time in minutes
  // The confession: user must type >=20 words explaining WHY this trade
  // fits their plan. The system classifies it as plan-driven or tilt-driven.
  confession      String
  confessionClass String   @default("unclassified") // plan_driven | tilt_driven | unclassified
  tiltAtConfession Float   @default(0) // tilt score when confession was submitted
  // Execution tracking
  executed        Boolean  @default(false)
  executedAt      DateTime?
  exitReason      String?  // plan_exit | manual_exit | panic_exit | revenge_exit
  actualPnl       Float?
  actualPnlPct    Float?
  heldMinutes     Int?
  // Was this a deviation from a previously stated plan?
  deviatedFromPlan Boolean @default(false)
  createdAt       DateTime @default(now())
  @@index([pair, createdAt])
  @@index([executed])
}

// Behavioral profile — aggregated stats about the trader's patterns.
// Updated after every trade intention + execution. This is the
// "shadow self" data source.
model PsyopProfile {
  id                  String   @id @default("singleton")
  // Aggregate stats
  totalIntentions     Int      @default(0)
  totalExecutions     Int      @default(0)
  totalDeviations     Int      @default(0) // times they deviated from plan
  // Tilt history (rolling)
  currentTilt         Float    @default(0) // 0-100
  maxTilt             Float    @default(0)
  avgTilt             Float    @default(0)
  tiltHistoryJson     String   @default("[]") // JSON: [{ts, tilt}, ...] last 100
  // Behavioral fingerprints (Markov transition probabilities)
  // What do they typically do after a loss? after a win? after a long hold?
  afterLossBehavior   String   @default("{}") // JSON: {immediate_reentry: 0.6, wait_1h: 0.2, ...}
  afterWinBehavior    String   @default("{}")
  // Discipline metrics
  planAdherenceRate   Float    @default(0) // % of trades that followed plan
  avgConfessionLen    Float    @default(0)
  // Achievement badges (inverted — for BAD behaviors)
  badgesJson          String   @default("[]") // JSON: [{id, earnedAt, severity}, ...]
  // Session tracking
  currentSessionStart Int?
  currentSessionTrades Int    @default(0)
  lastTradeAt         Int?
  updatedAt           DateTime @updatedAt
}

// Confession log — every confession is stored for analysis. The system
// uses these to build the behavioral fingerprint and to shame the user
// with their own words when they're about to deviate.
model PsyopConfession {
  id           String   @id @default(cuid())
  intentionId  String?
  text         String   // the raw confession text (min 20 words)
  wordCount    Int
  classified   String   @default("unclassified") // plan_driven | tilt_driven | rationalization
  // Tilt indicators detected in the text
  hasFomo      Boolean  @default(false)
  hasRevenge   Boolean  @default(false)
  hasLossAversion Boolean @default(false)
  hasOverconfidence Boolean @default(false)
  tiltScore    Float    @default(0) // tilt score at time of confession
  createdAt    DateTime @default(now())
  @@index([createdAt])
}

// Alpha signal circuit breaker — per-pair consecutive loss tracking.
// After 3 consecutive OOS-validated losing signals, the circuit trips
// and signals for that pair are suppressed for a cooldown period.
model AlphaCircuitBreaker {
  id                  String   @id @default(cuid())
  pair                String   @unique
  consecutiveLosses   Int      @default(0)
  totalSignals        Int      @default(0)
  totalWins           Int      @default(0)
  totalLosses         Int      @default(0)
  circuitOpen         Boolean  @default(false)
  circuitOpenedAt     Int?
  circuitOpenUntil    Int?     // unix sec — cooldown expiry
  circuitTrips        Int      @default(0)
  lastSignalAt        Int?
  lastSignalAction    String?  // LONG | SHORT | FLAT
  lastSignalOutcome   String?  // win | loss | pending
  updatedAt           DateTime @updatedAt
}

