{
  "annotations": { "list": [] },
  "description": "Alpha Signal Engine dashboard — funding z-score, OOS win rate, Kelly CI, liquidity cap, circuit breaker. Requires Prometheus scraping /api/signal/metrics.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Capital at Risk",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.03 }, { "color": "red", "value": 0.06 }] }
        }
      },
      "targets": [{ "expr": "alpha_capital_at_risk", "refId": "A" }]
    },
    {
      "title": "Funding Z-Score per Pair (180p window)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "alpha_funding_zscore", "legendFormat": "{{pair}}", "refId": "A" }],
      "thresholds": [{ "value": 2, "color": "red" }, { "value": -2, "color": "red" }, { "value": 1, "color": "yellow" }, { "value": -1, "color": "yellow" }]
    },
    {
      "title": "Signals by Severity",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "critical": { "text": "CRITICAL", "color": "red" }, "error": { "text": "ERROR", "color": "orange" }, "warn": { "text": "WARN", "color": "yellow" }, "info": { "text": "INFO", "color": "blue" } }, "type": "value" }]
        }
      },
      "targets": [{ "expr": "alpha_signals_total", "legendFormat": "{{pair}} {{severity}}", "refId": "A" }]
    },
    {
      "title": "OOS Win Rate per Pair",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "alpha_oos_winrate", "legendFormat": "{{pair}}", "refId": "A" }],
      "thresholds": [{ "value": 0.5, "color": "green" }, { "value": 0.4, "color": "yellow" }]
    },
    {
      "title": "Kelly CI5 (Conservative Sizing)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "alpha_kelly_ci5", "legendFormat": "{{pair}} CI5", "refId": "A" },
        { "expr": "alpha_kelly_uncertainty", "legendFormat": "{{pair}} uncertainty", "refId": "B" }
      ]
    },
    {
      "title": "Liquidity Cap Active (1=order book too thin)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "CAPITAL CAP", "color": "green" }, "1": { "text": "LIQUIDITY CAP", "color": "red" } }, "type": "value" }]
        }
      },
      "targets": [{ "expr": "alpha_liquidity_cap_active", "legendFormat": "{{pair}}", "refId": "A" }]
    },
    {
      "title": "Regime Stability (Anchored vs Rolling agreement)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "UNSTABLE", "color": "red" }, "1": { "text": "STABLE", "color": "green" } }, "type": "value" }]
        }
      },
      "targets": [{ "expr": "alpha_regime_stable", "legendFormat": "{{pair}}", "refId": "A" }]
    },
    {
      "title": "Absorption Validated (1=OOS confirmed)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "NOT VALIDATED", "color": "red" }, "1": { "text": "VALIDATED", "color": "green" } }, "type": "value" }]
        }
      },
      "targets": [{ "expr": "alpha_absorption_validated", "legendFormat": "{{pair}}", "refId": "A" }]
    },
    {
      "title": "Data Stale (1=outdated candle data)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "FRESH", "color": "green" }, "1": { "text": "STALE", "color": "red" } }, "type": "value" }]
        }
      },
      "targets": [{ "expr": "alpha_data_stale", "legendFormat": "{{pair}}", "refId": "A" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["alpha", "signal", "trading"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Alpha Signal Engine",
  "uid": "alpha-signal-engine",
  "version": 1
}
